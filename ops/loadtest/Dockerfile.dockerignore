# Keeps secrets and host-specific files out of the load-test image (build context is the repository root).
.git
web
e2e
docs
ops/backup
ops/audit
**/node_modules
api/vendor
api/.env
api/.env.*
!api/.env.example
api/.phpunit.cache
api/tests
api/storage/logs/*
api/storage/framework/sessions/*
api/storage/framework/cache/*
api/storage/framework/views/*
api/storage/app/private/*
api/bootstrap/cache/*.php
