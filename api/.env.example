APP_NAME=Portal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_URL_WEB=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@portal.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CATALOG_CURRENCY=USD
CATALOG_SEED_COUNT=250

# Shared mailbox for "new quote request" mails. Empty = every staff and admin user.
QUOTES_NOTIFY_ADDRESS=
# Abuse caps (defaults shown): open quotes per company, upload attempts per user per hour, attachment bytes per company (500 MiB).
# QUOTES_MAX_OPEN_PER_COMPANY=50
# QUOTES_UPLOADS_PER_HOUR=120
# QUOTES_COMPANY_MAX_BYTES=524288000

# Invoicing. EVERY value here is a PLACEHOLDER: set real values before production (issuing is refused in production while the seller name is the placeholder).
# VAT is ONE rate per invoice in basis points (1900 = 19%), 0 to 5000. 0 is a placeholder, not a legal rate.
INVOICING_VAT_RATE_BP=0
INVOICING_VAT_LABEL=VAT
INVOICING_PAYMENT_TERMS_DAYS=30
INVOICING_SELLER_NAME="PLACEHOLDER SELLER NAME"
# Address lines are separated by |
INVOICING_SELLER_ADDRESS="PLACEHOLDER Street 1|00000 PLACEHOLDER City|PLACEHOLDER Country"
INVOICING_SELLER_TAX_ID="PLACEHOLDER-VAT-ID"
INVOICING_SELLER_EMAIL=billing@example.invalid
INVOICING_SELLER_PHONE="+00 000 000000"
INVOICING_BANK_HOLDER=PLACEHOLDER
INVOICING_BANK_NAME="PLACEHOLDER BANK"
INVOICING_BANK_IBAN="XX00 PLACEHOLDER IBAN"
INVOICING_BANK_BIC=PLACEHOLDER
INVOICING_PAYMENT_TERMS_TEXT="Please pay by bank transfer and quote the invoice number. (PLACEHOLDER TEXT)"
INVOICING_FOOTER="PLACEHOLDER legal footer: registered office, registration number, managing directors."

# Phase 6 back office. Invitation links live 7 days; CSV imports through the API are capped (larger files: php artisan products:import).
INVITATION_EXPIRE_MINUTES=10080
ADMIN_IMPORT_MAX_ROWS=5000
ADMIN_IMPORT_MAX_BYTES=5242880

# Phase 7 hardening (every key is optional: the defaults shown are the safe local values; production values live in the deploy environment, see docs/ops/env.production.example).
# Reverse proxies in front of the app: comma separated IPs or CIDRs. Empty = trust nobody. "*" makes the app refuse to boot.
TRUSTED_PROXIES=
# Production, staging and any other non-local environment REFUSE to run with TRUSTED_PROXIES empty (every visitor would share the proxy IP and its rate limits), unless clients reach the app directly with no proxy: then set TRUSTED_PROXIES_NONE=true.
# TRUSTED_PROXIES_NONE=false
# Exact host names the API answers to (comma separated). Host names only (no scheme, port, path or wildcard: the app refuses to boot). Empty = any Host (local only); REQUIRED outside local, testing and loadtest.
TRUSTED_HOSTS=
# Breached-password check (Have I Been Pwned range API, 5-character hash prefix only, fails open). Off for local development.
AUTH_PASSWORD_BREACH_CHECK=false
# Strict-Transport-Security max-age in seconds for secure requests outside local, testing and loadtest (0 = do not send).
# PORTAL_HSTS_MAX_AGE=31536000
# Result window of every list: page * per_page may not exceed it.
# PORTAL_MAX_WINDOW=10000
# Per-user limits per minute: catalog search, order search (customers / staff), reorder.
# PORTAL_CATALOG_SEARCH_PER_MINUTE=40
# PORTAL_ORDER_SEARCH_PER_MINUTE=30
# PORTAL_ORDER_SEARCH_STAFF_PER_MINUTE=60
# PORTAL_ORDERS_REORDER_PER_MINUTE=10
# Log queries slower than this many ms (0 = off) and the free-space warning level of quotes:storage-check (bytes).
# PORTAL_SLOW_QUERY_MS=500
# PORTAL_STORAGE_MIN_FREE_BYTES=5368709120
# Log files kept by the daily_json channel (LOG_STACK=daily_json) and the password of the users made by portal:loadtest-seed (load databases only).
# LOG_DAILY_DAYS=14
# LOADTEST_PASSWORD=
