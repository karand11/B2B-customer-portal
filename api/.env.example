APP_NAME=Portal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_URL_WEB=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@portal.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CATALOG_CURRENCY=USD
CATALOG_SEED_COUNT=250

# Shared mailbox for "new quote request" mails. Empty = every staff and admin user.
QUOTES_NOTIFY_ADDRESS=
# Abuse caps (defaults shown): open quotes per company, upload attempts per user per hour, attachment bytes per company (500 MiB).
# QUOTES_MAX_OPEN_PER_COMPANY=50
# QUOTES_UPLOADS_PER_HOUR=120
# QUOTES_COMPANY_MAX_BYTES=524288000

# Invoicing. EVERY value here is a PLACEHOLDER: set real values before production (issuing is refused in production while the seller name is the placeholder).
# VAT is ONE rate per invoice in basis points (1900 = 19%), 0 to 5000. 0 is a placeholder, not a legal rate.
INVOICING_VAT_RATE_BP=0
INVOICING_VAT_LABEL=VAT
INVOICING_PAYMENT_TERMS_DAYS=30
INVOICING_SELLER_NAME="PLACEHOLDER SELLER NAME"
# Address lines are separated by |
INVOICING_SELLER_ADDRESS="PLACEHOLDER Street 1|00000 PLACEHOLDER City|PLACEHOLDER Country"
INVOICING_SELLER_TAX_ID="PLACEHOLDER-VAT-ID"
INVOICING_SELLER_EMAIL=billing@example.invalid
INVOICING_SELLER_PHONE="+00 000 000000"
INVOICING_BANK_HOLDER=PLACEHOLDER
INVOICING_BANK_NAME="PLACEHOLDER BANK"
INVOICING_BANK_IBAN="XX00 PLACEHOLDER IBAN"
INVOICING_BANK_BIC=PLACEHOLDER
INVOICING_PAYMENT_TERMS_TEXT="Please pay by bank transfer and quote the invoice number. (PLACEHOLDER TEXT)"
INVOICING_FOOTER="PLACEHOLDER legal footer: registered office, registration number, managing directors."

# Phase 6 back office. Invitation links live 7 days; CSV imports through the API are capped (larger files: php artisan products:import).
INVITATION_EXPIRE_MINUTES=10080
ADMIN_IMPORT_MAX_ROWS=5000
ADMIN_IMPORT_MAX_BYTES=5242880
