<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Phase 7: the suite must give the same result whatever the developer's .env defines (force="true" beats the process environment too). -->
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_URL_WEB" value="http://localhost:5173" force="true"/>
        <env name="CORS_ALLOWED_ORIGINS" value="http://localhost:5173" force="true"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173" force="true"/>
        <env name="AUTH_PASSWORD_BREACH_CHECK" value="false" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="TRUSTED_PROXIES_NONE" value="false" force="true"/>
        <env name="TRUSTED_HOSTS" value="" force="true"/>
        <env name="PORTAL_HSTS_MAX_AGE" value="31536000" force="true"/>
        <env name="PORTAL_MAX_WINDOW" value="10000" force="true"/>
        <env name="PORTAL_CATALOG_SEARCH_PER_MINUTE" value="40" force="true"/>
        <env name="PORTAL_ORDER_SEARCH_PER_MINUTE" value="30" force="true"/>
        <env name="PORTAL_ORDER_SEARCH_STAFF_PER_MINUTE" value="60" force="true"/>
        <env name="PORTAL_ORDERS_REORDER_PER_MINUTE" value="10" force="true"/>
        <env name="PORTAL_SLOW_QUERY_MS" value="500" force="true"/>
        <env name="PORTAL_STORAGE_MIN_FREE_BYTES" value="5368709120" force="true"/>
        <env name="LOG_LEVEL" value="debug" force="true"/>
        <env name="LOG_STACK" value="single" force="true"/>
        <env name="LOADTEST_PASSWORD" value="" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="portal_test" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- ~1700 tests in one process plus PDF rendering: do not depend on the machine's php.ini (CLI default is 128M) -->
        <ini name="memory_limit" value="256M"/>
    </php>
</phpunit>
