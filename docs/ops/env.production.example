# Production (and staging) environment for the API: Phase 8 checklist.
# FORMAT: plain KEY=value lines. Do NOT put inline `# comments` after a value: dotenv strips them but systemd
# EnvironmentFile and `docker --env-file` do not, and the comment would become part of the value (the app then fails
# closed at boot). The explanatory comments below are for reading only: delete them in the real file.
# Copy to the server's secret store, NEVER commit real values. `php artisan portal:check-config` refuses to
# pass (and the app refuses to serve in production/staging) when the unsafe defaults below are left in place.

APP_NAME=Portal
APP_ENV=production                 # or staging
APP_DEBUG=false
APP_KEY=                           # php artisan key:generate --show ; keep a sealed copy: losing it kills sessions and encrypted queued jobs
APP_URL=https://portal.example.com
APP_URL_WEB=https://portal.example.com   # invitation/reset/quote links are built from this, never from the Host header

# One origin: Nginx serves the SPA and proxies /api and /sanctum to PHP-FPM (CSP connect-src 'self', host-only cookies).
CORS_ALLOWED_ORIGINS=https://portal.example.com
SANCTUM_STATEFUL_DOMAINS=portal.example.com
# Host names only: no scheme, port, path, wildcard, IPv6 literal or trailing dot (a bad list stops the boot; check-config reports it).
TRUSTED_HOSTS=portal.example.com
TRUSTED_PROXIES=10.0.0.5           # exact IPs/CIDRs of YOUR reverse proxy/load balancer. Never '*'; a prefix shorter than /8 (IPv4) or /16 (IPv6) is refused at boot. The proxy must OVERWRITE X-Forwarded-For.
# An EMPTY TRUSTED_PROXIES is UNSAFE (portal:check-config exits 1, the app answers 500) unless TRUSTED_PROXIES_NONE=true.
# Set true ONLY when clients reach the app with no proxy; otherwise list the proxy IPs/CIDRs above and leave this false.
# If both are set the list wins and the flag is ignored (not flagged by check-config).
TRUSTED_PROXIES_NONE=false
# These rules apply in every APP_ENV except local, testing and loadtest (case-insensitive), so a typo such as 'prod' is enforced too.
PORTAL_HSTS_MAX_AGE=31536000       # 0 if Nginx sends HSTS instead

# Sessions (decisions in docs/phase-7-design.md 3.4)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_DOMAIN=
SESSION_COOKIE=__Host-portal_session
SESSION_ENCRYPT=true

# Cache/limiters must be atomic across workers: 'file' is not.
CACHE_STORE=database
QUEUE_CONNECTION=database

# Database: runtime uses the restricted role; migrations run with the owner role (ops/db/roles.sql).
# Deploy order: migrate as the owner, RE-RUN ops/db/roles.sql (OWNER_PASSWORD/APP_PASSWORD from the environment), verify, then go live.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=portal
DB_USERNAME=portal_app
DB_PASSWORD=
# Deploy step only: DB_USERNAME=portal_owner DB_PASSWORD=... php artisan migrate --force

# Mail (real provider; SPF/DKIM on the sender domain)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
QUOTES_NOTIFY_ADDRESS=             # monitored shared mailbox for 'new quote' mails

# Invoicing: REAL seller details and VAT rate (a placeholder seller is refused when issuing invoices; portal:check-config warns, --strict fails)
INVOICING_SELLER_NAME=
INVOICING_VAT_RATE_BP=
# ...see api/.env.example for the full INVOICING_* list

# Logging
LOG_CHANNEL=stack                  # channels are defined in api/config/logging.php (docs/phase-7-design.md 4.1)
LOG_STACK=daily_json               # or stderr_json under systemd/Docker
LOG_DAILY_DAYS=14
LOG_LEVEL=warning                  # never 'debug' in production/staging (portal:check-config fails it)
AUTH_PASSWORD_BREACH_CHECK=true    # Pwned Passwords range API (5-char hash prefix only), fail-open

# Processes (not env): PHP-FPM with opcache (memory_limit 256M, upload_max_filesize 11M, post_max_size 12M),
# a queue worker (php artisan queue:work, supervised), the scheduler (cron: * * * * * php artisan schedule:run),
# Nginx client_max_body_size 12m, writable storage/ and storage/fonts.
